# Normalize line endings to LF for cross-platform consistency
* text=auto eol=lf

# Explicit LF formatting for source code and web assets
*.go text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
