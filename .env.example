# =============================================================================
# JellyGate v2.0.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust default values.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────

# HTTP listening port (default: 8097)
JELLYGATE_PORT=8097

# Public URL of JellyGate (used for callbacks and emails)
# Example: https://jellygate.example.com
JELLYGATE_BASE_URL=http://localhost:8097

# Data storage directory (SQLite DB, backups) — in Docker: /data
JELLYGATE_DATA_DIR=/data

# User / Group ID for container volume permissions
PUID=1000
PGID=1000

# Timezone (UTC used by default)
TZ=UTC

# Database configuration ('sqlite' or 'postgres')
DB_TYPE=sqlite

# PostgreSQL parameters (when DB_TYPE=postgres)
DB_HOST=
DB_PORT=5432
DB_USER=jellygate
DB_PASSWORD=jellygate_password
DB_NAME=jellygate
DB_SSLMODE=disable

# [REQUIRED] Secret key for signing session cookies (min 32 chars)
# Generate with: openssl rand -hex 32
JELLYGATE_SECRET_KEY=change_this_to_a_secure_random_32_character_string

# Default interface language (fr, en, de, es, it, nl, pl, pt-br, ru, zh)
JELLYGATE_DEFAULT_LANG=en

# Security & Reverse Proxy
JELLYGATE_TRUST_PROXY_HEADERS=true
JELLYGATE_ENABLE_DEBUG_ROUTES=false

# ─── Authentik OIDC & Identity Provider (SSO) ──────────────────────────────

# [REQUIRED] Base URL of your Authentik instance (e.g. https://authentik.example.com)
AUTHENTIK_URL=https://authentik.example.com

# [REQUIRED] OIDC Issuer URL (e.g. https://authentik.example.com/application/o/jellygate/)
OIDC_ISSUER_URL=https://authentik.example.com/application/o/jellygate/

# [REQUIRED] OIDC Client ID from Authentik provider
OIDC_CLIENT_ID=jellygate_client_id

# [REQUIRED] OIDC Client Secret from Authentik provider
OIDC_CLIENT_SECRET=jellygate_client_secret

# [REQUIRED] OIDC Redirect Callback URL
OIDC_REDIRECT_URL=http://localhost:8097/auth/callback

# [REQUIRED] Authentik API Service Account Token (for creating Stage Tokens & Recovery links)
AUTHENTIK_API_TOKEN=ak_api_token_here

# Group Mappings in Authentik (Groups assigned to users)
OIDC_USER_GROUP=jellygate-users
OIDC_ADMIN_GROUP=jellygate-admins

# Authentik Enrollment Flow slug used for invitations
AUTHENTIK_ENROLLMENT_FLOW_SLUG=default-enrollment-flow

# ─── Jellyfin Integration (Optional) ────────────────────────────────────────

# [OPTIONAL] URL of your Jellyfin server (e.g. http://192.168.1.10:8096)
# Leave empty if you do not use Jellyfin domain features (presets, libraries, avatars).
JELLYFIN_URL=http://jellyfin:8096

# [OPTIONAL] Jellyfin API Key (Dashboard → API Keys)
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# ─── Third-Party Integrations (Optional) ────────────────────────────────────

# Jellyseerr / Seerr (Automatic provisioning)
JELLYSEERR_URL=
JELLYSEERR_API_KEY=

# Ombi (Alternative to Seerr)
OMBI_URL=
OMBI_API_KEY=

# JellyTrack
JELLYTRACK_URL=
JELLYTRACK_API_KEY=
