# =============================================================================
# JellyGate v2.0.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values.
#
# MANDATORY / REQUIRED VARIABLES:
#   1. JELLYGATE_SECRET      : MUST be set and MUST be at least 32 characters long.
#                              Generate with: openssl rand -hex 32
#   2. OIDC / SSO Provider   : Required when SSO is enabled (default):
#                              - OIDC_ENABLED (true/false)
#                              - OIDC_URL (OIDC Provider / Issuer URL)
#                              - OIDC_CLIENT_ID
#                              - OIDC_CLIENT_SECRET
#                              - OIDC_API_TOKEN (Identity Provider Admin Token, optional)
#   3. PostgreSQL DB         : Required ONLY when DB_TYPE=postgres
#                              - DB_HOST, DB_USER, DB_NAME
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────

# HTTP listening port (default: 8097)
JELLYGATE_PORT=8097

# Public URL of JellyGate (used for callbacks and emails)
# Example: https://jellygate.example.com
JELLYGATE_BASE_URL=http://localhost:8097

# Data storage directory (SQLite DB, backups) — in Docker: /data
JELLYGATE_DATA_DIR=/data

# User / Group ID for container volume permissions
PUID=1000
PGID=1000

# Timezone (UTC used by default)
TZ=UTC

# Database configuration ('sqlite' or 'postgres')
DB_TYPE=sqlite

# PostgreSQL parameters (when DB_TYPE=postgres)
DB_HOST=
DB_PORT=5432
DB_USER=jellygate
DB_PASSWORD=jellygate_password
DB_NAME=jellygate
DB_SSLMODE=disable

# [REQUIRED] Secret key for signing session cookies (min 32 chars)
# Generate with: openssl rand -hex 32
JELLYGATE_SECRET=change_this_to_a_secure_random_32_character_string

# Default interface language (fr, en, de, es, it, nl, pl, pt-br, ru, zh)
JELLYGATE_DEFAULT_LANG=en

# Security & Reverse Proxy
JELLYGATE_TRUST_PROXY_HEADERS=true
JELLYGATE_ENABLE_DEBUG_ROUTES=false

# ─── Local Emergency Admin (Optional / Disabled by default) ─────────────────
# Set a password to enable emergency break-glass login at /local
# JELLYGATE_LOCAL_ADMIN_USER=admin
# JELLYGATE_LOCAL_ADMIN_PASSWORD=change_this_to_a_secure_local_password

# ─── OIDC & Identity Provider (Authentik, Keycloak, Authelia, etc.) ─────────

# Enable OpenID Connect / SSO login
OIDC_ENABLED=true

# [REQUIRED] OpenID Connect Authority / Provider Issuer URL
# Examples:
#   - Authentik : https://authentik.example.com/application/o/jellygate/
#   - Keycloak  : https://keycloak.example.com/realms/master
#   - Authelia  : https://auth.example.com/api/oidc
OIDC_URL=https://authentik.example.com/application/o/jellygate/

# [REQUIRED] OIDC Client ID
OIDC_CLIENT_ID=jellygate

# [REQUIRED] OIDC Client Secret
OIDC_CLIENT_SECRET=jellygate_client_secret

# [OPTIONAL] OIDC Redirect Callback URL (default: JELLYGATE_BASE_URL/auth/callback)
OIDC_REDIRECT_URL=http://localhost:8097/auth/callback

# [OPTIONAL] Identity Provider Admin API Token (for account provisioning/invitations)
OIDC_API_TOKEN=ak_api_token_here

# [OPTIONAL] Role & Group mappings (defaults shown)
OIDC_USER_GROUP=jellygate-users
OIDC_ADMIN_GROUP=jellygate-admins
OIDC_JELLYFIN_USER_GROUP=jellyfin-users
OIDC_ENROLLMENT_FLOW_SLUG=default-enrollment-flow

# ─── Jellyfin Integration (Optional) ────────────────────────────────────────
# Why optional? JellyGate manages user accounts directly in Authentik (LDAP/OIDC).
# Jellyfin URL & API Key are only needed if you want JellyGate to interact directly
# with the Jellyfin admin API (server name, libraries, presets, diagnostics).
# Public links are also configurable directly in the application settings (/admin/settings).

# [OPTIONAL] URL of your Jellyfin server (e.g. http://192.168.1.10:8096)
JELLYFIN_URL=http://jellyfin:8096

# [OPTIONAL] Jellyfin API Key (Dashboard → API Keys)
JELLYFIN_API_KEY=your_jellyfin_api_key_here

# ─── Third-Party Integrations (Optional) ────────────────────────────────────

# Jellyseerr / Seerr (Automatic provisioning)
JELLYSEERR_URL=
JELLYSEERR_API_KEY=

# JellyTrack
JELLYTRACK_URL=
JELLYTRACK_API_KEY=

