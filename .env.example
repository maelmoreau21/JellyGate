# =============================================================================
# JellyGate — Configuration Example
# =============================================================================
# Copy this file to .env and fill in the values.
#
# IMPORTANT: Only essential startup parameters are located here.
# LDAP, SMTP, and Webhooks configurations are managed via the admin UI
# (and stored in the database).
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────

# HTTP listening port (default: 8097)
JELLYGATE_PORT=8097

# Public URL of JellyGate (used in emails and invitation links)
# Example: https://jellygate.example.com
JELLYGATE_BASE_URL=http://localhost:8097

# Data storage directory (SQLite, config, etc.) — in Docker: /data
JELLYGATE_DATA_DIR=/data

# User / Group ID for container volume permissions (used via user: "${PUID}:${PGID}" in Docker Compose)
PUID=1000
PGID=1000

# Timezone (UTC is used globally by JellyGate logs and database)
TZ=UTC

# Database configuration:
# - DB_TYPE: 'sqlite' or 'postgres'.
# - Auto-detection: If DB_TYPE is omitted and DB_HOST is set, JellyGate automatically selects 'postgres'.
DB_TYPE=sqlite

# PostgreSQL parameters (used when DB_TYPE=postgres or when DB_HOST is set)
DB_HOST=
DB_PORT=5432
DB_USER=jellygate
DB_PASSWORD=jellygate_password
DB_NAME=jellygate
DB_SSLMODE=disable

# [REQUIRED] Secret key for signing session cookies (minimum 32 characters)
# Generate with: openssl rand -hex 32
JELLYGATE_SECRET=

# Default interface language (fr, en, de, es, it, nl, pl, pt-br, ru, zh)
JELLYGATE_DEFAULT_LANG=en

# Admin debug routes (disabled by default; do not enable in production)
JELLYGATE_ENABLE_DEBUG_ROUTES=false
JELLYGATE_TRUST_PROXY_HEADERS=false
JELLYGATE_ALLOW_INSECURE_LDAP_SKIP_VERIFY=false

# ─── Jellyfin ────────────────────────────────────────────────────────────────

# [REQUIRED] URL of your Jellyfin server (e.g., http://192.168.1.10:8096)
JELLYFIN_URL=

# [REQUIRED] Jellyfin API Key (Dashboard → API Keys)
JELLYFIN_API_KEY=

# ─── Third-Party Integrations (Optional) ────────────────────────────────────

# Jellyseerr / Seerr (Automatic provisioning)
JELLYSEERR_URL=
JELLYSEERR_API_KEY=

# Ombi (Alternative to Seerr)
OMBI_URL=
OMBI_API_KEY=

# JellyTrack
JELLYTRACK_URL=
JELLYTRACK_API_KEY=
